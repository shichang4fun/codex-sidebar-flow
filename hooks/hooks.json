{
  "description": "Observe task starts and reconcile terminal stops after sibling Hook outcomes settle.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec /bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin-hook.sh\"",
            "timeout": 20,
            "async": true
          }
        ]
      }
    ]
  }
}
